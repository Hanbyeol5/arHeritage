# 로컬 개발용: 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 git 에 올라가지 않음)

# 네이버 클라우드 플랫폼 Maps > Application 의 Client ID
# 비어 있으면 지도 대신 안내 문구가 표시된다.
VITE_NAVER_MAP_KEY_ID=

# --- 아래는 빌드 시점 데이터 보강용 (앱 번들에 포함되지 않음, GitHub Actions Secret 으로 관리) ---
# ANTHROPIC_API_KEY=
# GG_DATA_API_KEY=
# DATA_GO_KR_API_KEY=

# 4단계 Cloudflare Worker 주소 (AI 유물 인식·인물 대화). 비어 있으면 위치 기반 인식으로 대체한다.
VITE_API_BASE=
