# 로컬 개발용: 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 git 에 올라가지 않음)
# 두 값 모두 공개 값이라 앱 코드에 포함되어도 되며, 배포본은 GitHub Variables 의 같은 값을 쓴다.

# 네이버 클라우드 플랫폼 Maps > Application 의 Client ID (Web 서비스 URL 에 http://localhost:5173 등록 필요)
# 비어 있으면 지도 대신 안내 문구가 표시된다.
VITE_NAVER_MAP_KEY_ID=e8pjow6xrb

# 인물 대화·음성·유물 인식 API (Cloudflare Worker) 주소. 로컬 Worker 를 띄웠다면 http://localhost:8787
# 비어 있으면 대화가 꺼지고 유물 인식은 위치 기반으로 대체된다.
VITE_API_BASE=https://yeoksadam-api.samdori93.workers.dev
